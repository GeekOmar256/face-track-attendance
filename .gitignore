# Paths are matched at any depth, so they cover version1/data/... and
# version2/data/... as well as a plain data/... layout.

# ---------------------------------------------------------------- biometric data
# Student face images NEVER go in the repository. The FYP1 plan commits to
# keeping biometric data on the device, and consent to be photographed for an
# attendance prototype is not consent to be published on GitHub.
**/data/dataset/*
!**/data/dataset/.gitkeep

# ---------------------------------------------------------------- trained models
# A trained gallery or LBPH model is derived from those same face images, so it
# is biometric data too and stays local. The ONNX files are fetched by
# scripts/download_models.py rather than committed.
**/data/models/*
!**/data/models/.gitkeep

# ---------------------------------------------------------------- results
# Regenerated by benchmark_detectors.py and evaluate_recognition.py.
**/data/output/*
!**/data/output/.gitkeep

# ---------------------------------------------------------------- uploads
# Videos and photos pushed to the server through the web interface.
**/data/uploads/*
!**/data/uploads/.gitkeep

# ---------------------------------------------------------------- python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---------------------------------------------------------------- editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
